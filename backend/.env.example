# Copy to .env for local use, or add these as environment variables on Render.
# Never commit a real .env file.

# Postgres connection string. On Supabase use the Session pooler string (port 5432) with your
# database password in it. Leave unset to use a local SQLite file.
DATABASE_URL=

# Long random text used to sign login sessions. Required in production.
JWT_SECRET=

# Groq API key from console.groq.com. Leave empty to run exact checks only.
GROQ_API_KEY=

# Optional. Defaults shown.
# AI_MODEL=openai/gpt-oss-120b
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_PROVIDER_NAME=Groq
# JWT_HOURS=12
# DEMO_PASSWORD=brandguard-demo

# The website's address(es), comma-separated, no trailing slash.
CORS_ORIGINS=http://localhost:5173

# Render only: the Python version to build with.
# PYTHON_VERSION=3.14.0
